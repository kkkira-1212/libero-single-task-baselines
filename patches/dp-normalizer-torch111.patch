diff --git a/diffusion_policy/model/common/parameter_dict_compat.py b/diffusion_policy/model/common/parameter_dict_compat.py
new file mode 100644
index 0000000..9fa394c
--- /dev/null
+++ b/diffusion_policy/model/common/parameter_dict_compat.py
@@ -0,0 +1,48 @@
+"""Nested tensor storage for older PyTorch, preserving upstream state_dict paths."""
+from collections.abc import Mapping
+import torch
+from torch import nn
+
+class TensorParameterDict(nn.Module):
+    """Mapping of nontrainable tensors and nested modules; no numeric transforms."""
+    def __init__(self, values=None):
+        super().__init__()
+        self._ordered_keys=[]
+        if values is not None:
+            self.update(values)
+    def __setitem__(self,key,value):
+        if not isinstance(key,str) or "." in key:
+            raise KeyError("Expected a simple string key")
+        if isinstance(value,Mapping):
+            value=TensorParameterDict(value)
+        if key not in self._ordered_keys:
+            self._ordered_keys.append(key)
+        if key in self._parameters:
+            del self._parameters[key]
+        if key in self._modules:
+            del self._modules[key]
+        if isinstance(value,torch.Tensor):
+            self.register_parameter(key,nn.Parameter(value.detach(),requires_grad=False))
+        elif isinstance(value,nn.Module):
+            self.add_module(key,value)
+        else:
+            raise TypeError(type(value))
+    def __getitem__(self,key):
+        if key in self._parameters:
+            return self._parameters[key]
+        return self._modules[key]
+    def __contains__(self,key):
+        return key in self._ordered_keys
+    def __iter__(self):
+        return iter(self._ordered_keys)
+    def __len__(self):
+        return len(self._ordered_keys)
+    def keys(self):
+        return list(self._ordered_keys)
+    def items(self):
+        return [(key,self[key]) for key in self]
+    def values(self):
+        return [self[key] for key in self]
+    def update(self,values):
+        for key,value in values.items():
+            self[key]=value
